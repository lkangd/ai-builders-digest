{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lkangd.github.io/ai-builders-digest/trending/schema/issue.schema.json",
  "title": "GitHub Trending daily issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edition",
    "date",
    "timezone",
    "language",
    "collectedAt",
    "collectedAtLabel",
    "collectedAtAbbr",
    "source",
    "intro",
    "featuredLede",
    "picks",
    "mentions",
    "emailHighlights",
    "dataNotes"
  ],
  "properties": {
    "edition": { "enum": ["official", "sample", "example"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "const": "America/New_York" },
    "language": { "const": "zh" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "collectedAtLabel": { "type": "string" },
    "collectedAtAbbr": { "enum": ["EST", "EDT"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "since", "spokenLanguage", "url"],
      "properties": {
        "list": { "const": "github-trending" },
        "since": { "const": "daily" },
        "spokenLanguage": { "const": "all" },
        "url": { "const": "https://github.com/trending?since=daily" },
        "listedRepoCount": { "type": "integer", "minimum": 0 }
      }
    },
    "previewLabel": { "type": "string", "minLength": 1 },
    "previewNotice": { "type": "string", "minLength": 1 },
    "intro": { "type": "string", "minLength": 1 },
    "featuredLede": { "type": "string", "minLength": 1 },
    "picks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/pick" }
    },
    "mentions": {
      "type": "array",
      "items": { "$ref": "#/$defs/mention" }
    },
    "emailHighlights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "url"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "url": { "type": "string" }
        }
      }
    },
    "dataNotes": { "type": "string", "minLength": 1 },
    "sample": { "type": "object" },
    "example": { "type": "object" }
  },
  "$defs": {
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "name", "repo", "url", "featured", "metrics", "try"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "titleAsRecorded": { "type": "string" },
        "repo": { "type": "string" },
        "url": { "type": "string" },
        "homepage": { "type": "string" },
        "returning": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "selectionNotes": { "type": "array", "items": { "type": "string" } },
        "metrics": { "$ref": "#/$defs/metrics" },
        "purpose": { "type": "string" },
        "highlights": { "type": "string" },
        "value": { "type": "string" },
        "changes": { "type": "string" },
        "lead": { "type": "string" },
        "try": { "type": "string" },
        "verifiedFacts": { "type": "string" },
        "claimLabel": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asRecorded"],
      "properties": {
        "asRecorded": { "type": "string" },
        "language": { "type": "string" },
        "license": { "type": "string" },
        "stars": { "type": "integer", "minimum": 0 },
        "starsToday": { "type": "integer", "minimum": 0 }
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "url", "note"],
      "properties": {
        "repo": { "type": "string" },
        "url": { "type": "string" },
        "note": { "type": "string" },
        "stars": { "type": "integer", "minimum": 0 },
        "starsToday": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
